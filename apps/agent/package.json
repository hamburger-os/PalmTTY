{
  "name": "@palmtty/agent",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts --development",
    "preflight": "tsx src/index.ts --preflight",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @palmtty/protocol build && pnpm --filter @palmtty/config build && vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "@palmtty/config": "workspace:*",
    "@palmtty/protocol": "workspace:*",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "fastify": "^5.12.7",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "files": [
    "dist"
  ]
}
